.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Run outputs ARE committed (SPEC §13a item 9). A Kaggle/Colab session can die
# without warning — one full n=750 sweep was already lost that way before the
# push-after-every-run habit existed. Committing them is the archive.
!results/
logs/
figures/
*.zip
*.tmp
*.partial
*.lock.tmp

# Analysis tables/figures are generated. The immutable selector trace and its
# executable frozen config are deliberate commit artifacts and stay visible.
analysis/*
!analysis/ma_optimized_exploratory.selection.json
!analysis/ma_optimized_exploratory.experiment.yaml
!analysis/pilot_gate.json

.ipynb_checkpoints/
